{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri/refs/heads/v2/packages/config-schema/schema.json",
  "productName": "Eushully BIN Editor",
  "version": "1.0.0",
  "identifier": "com.eushully-bin-editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Eushully BIN Editor",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
